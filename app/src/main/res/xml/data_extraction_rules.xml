<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: keep the vault database and score history out of cloud backup
     and out of device-to-device transfer. The AES key can't leave the Keystore, so a copied
     database would be unreadable anyway; this keeps the encrypted data from leaving at all. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
